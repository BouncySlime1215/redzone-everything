 "search": {
  "why": "For channels with no working code, the stick opens YouTube TV's search, types the channel name and picks the first result. The YouTube TV app draws its own screen (Cobalt), so these key presses are blind; they are data so they can be tuned on the device without code changes. UNVERIFIED until run on a real stick.",
  "recipes": [
   {"name": "search-link", "steps": [
    {"view": "https://tv.youtube.com/search?q={q_url}"}, {"wait": 7},
    {"keys": ["KEYCODE_DPAD_DOWN", "KEYCODE_DPAD_CENTER"]}, {"wait": 7},
    {"if_not_playing": [{"keys": ["KEYCODE_DPAD_CENTER"]}, {"wait": 6}]}
   ]},
   {"name": "search-typed", "steps": [
    {"view": "https://tv.youtube.com/"}, {"wait": 8},
    {"keys": ["KEYCODE_SEARCH"]}, {"wait": 3},
    {"text": "{q}"}, {"wait": 3},
    {"keys": ["KEYCODE_DPAD_DOWN", "KEYCODE_DPAD_CENTER"]}, {"wait": 7},
    {"if_not_playing": [{"keys": ["KEYCODE_DPAD_CENTER"]}, {"wait": 6}]}
   ]},
   {"name": "network-page", "needs": "browse_id", "steps": [
    {"view": "https://tv.youtube.com/browse/{browse_id}"}, {"wait": 7},
    {"keys": ["KEYCODE_DPAD_CENTER"]}, {"wait": 7},
    {"if_not_playing": [{"keys": ["KEYCODE_DPAD_DOWN", "KEYCODE_DPAD_CENTER"]}, {"wait": 6}]}
   ]}
  ]
 },
