<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.redzone.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/nick_matta/Documents/Codex/2026-11-02/task-2/redzone/.venv-agent/bin/python</string>
		<string>-u</string>
		<string>-c</string>
		<string>import os, runpy, sys; os.chdir('/Users/nick_matta/Documents/Codex/2026-11-02/task-2/redzone'); sys.path.insert(0, '/Users/nick_matta/Documents/Codex/2026-11-02/task-2/redzone'); sys.argv = ['agent.watchdog', '--no-model']; runpy.run_module('agent.watchdog', run_name='__main__', alter_sys=True)</string>
	</array>
	<!-- No WorkingDirectory and no log under ~/Documents: macOS privacy (TCC) closes it to launchd,
	     which then fails the job with EX_CONFIG (78). Python (Full Disk Access) changes into the repo. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<!-- Low impact: efficiency cores, lowest priority, background disk I/O. -->
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>15</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/nick_matta/Library/Logs/redzone/agent.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/nick_matta/Library/Logs/redzone/agent.log</string>
</dict>
</plist>
